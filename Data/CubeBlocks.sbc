  <CubeBlocks>
    <Definition xsi:type="MyObjectBuilder_UpgradeModuleDefinition">
      <Id><TypeId>UpgradeModule</TypeId><SubtypeId>VoidwrightNavigationControllerSmall</SubtypeId></Id>
      <Public>true</Public><GuiVisible>true</GuiVisible><DisplayName>Voidwright Navigation Controller</DisplayName>
      <Description>Vehicle-aware navigation computer. Absorbs intent from vanilla AI providers without granting them movement authority.</Description>
