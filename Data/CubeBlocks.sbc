      <Model>Models\Cubes\Small\EventController.mwm</Model><ModelOffset x="0" y="0" z="0" />
      <Components><Component Subtype="InteriorPlate" Count="2" /><Component Subtype="Computer" Count="2" /><Component Subtype="Display" Count="1" /></Components>
      <CriticalComponent Subtype="Display" Index="0" /><BlockPairName>VoidwrightNavigationController</BlockPairName>
      <ResourceSinkGroup>Utility</ResourceSinkGroup><Upgrades /><PCU>1</PCU><IsAirTight>false</IsAirTight>
    </Definition>
